figure.facecolor: black
figure.edgecolor: black
figure.dpi: 120
savefig.facecolor: black
savefig.edgecolor: black
savefig.dpi: 300
savefig.bbox: tight

axes.facecolor: black
axes.edgecolor: 4B5563
axes.labelcolor: F3F5F7
axes.titlecolor: F3F5F7
axes.grid: True
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['76B900', '00A3E0', 'F5B642', 'D7E3F4', 'A8B0B8'])

grid.color: 2F3A44
grid.alpha: 0.75
grid.linewidth: 0.9

text.color: F3F5F7
xtick.color: F3F5F7
ytick.color: F3F5F7

lines.linewidth: 2.5
lines.markersize: 6

legend.facecolor: black
legend.edgecolor: 4B5563
legend.labelcolor: F3F5F7
legend.framealpha: 1.0

font.size: 11
axes.titlesize: 13
axes.labelsize: 12
legend.fontsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
