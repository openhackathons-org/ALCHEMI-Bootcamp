# Build context is the dev/ root; this file controls what gets sent to
# the Docker daemon for the unified image build.
.git
.claude/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
matplotlib-*/
tmp*/
.Trash-*

# Per-part transient/local artefacts (compose bind-mounts still expose them
# at runtime; this keeps them out of the baked image only). Keep tracked
# tutorial assets in the image for Enroot/Pyxis runs without bind mounts.
part-1-scalable-atomistic-workflows/outputs/
# Superseded Part 1 research paths. Keep them in the repository history, but
# do not ship them in the learner image.
part-1-scalable-atomistic-workflows/aux/benchmark_results.py
part-1-scalable-atomistic-workflows/aux/models/orbmol.py
part-1-scalable-atomistic-workflows/aux/models/orbmol_checks.py
part-1-scalable-atomistic-workflows/aux/models/orbmol_config.py
part-1-scalable-atomistic-workflows/aux/models/orbmol_wrapper.py
part-1-scalable-atomistic-workflows/data/compute_lab_distributed_pipeline/
part-1-scalable-atomistic-workflows/data/compute_lab_distributed_pipeline.provenance.md
part-1-scalable-atomistic-workflows/assets/images/banner_candidates/README.md
part-1-scalable-atomistic-workflows/assets/images/banner_candidates/water-ir-v2-01-hydrogen-bond-landscape.png
part-1-scalable-atomistic-workflows/assets/images/banner_candidates/water-ir-v2-02-batched-water-systems.png
part-1-scalable-atomistic-workflows/assets/images/banner_candidates/water-ir-v2-03-composed-potential.png

# Keep only the four CPU-capable tests that the Dockerfile runs. The remaining
# development tests include host-only jobs and the retired OrbMol lesson.
part-1-scalable-atomistic-workflows/tests/*
!part-1-scalable-atomistic-workflows/tests/test_notebook_contract.py
!part-1-scalable-atomistic-workflows/tests/test_artifact_manifest.py
!part-1-scalable-atomistic-workflows/tests/test_reference_data.py
!part-1-scalable-atomistic-workflows/tests/test_experimental_reference.py

# Keep compact files named by the published checksum indexes, but omit
# unindexed calculation working files and duplicated consumer bundles.
part-1-scalable-atomistic-workflows/reference/tests/test_b97_3c_ir.py
part-1-scalable-atomistic-workflows/reference/artifacts/water_dimer_b97_3c/timer.dat
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/*.npy
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/*.npz
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/*.csv
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/*.xyz
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/*.out
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/*.dat
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/*.txt
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/diagnostics.json
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/**/run_config.json
part-1-scalable-atomistic-workflows/reference/artifacts/provenance/h6/artifacts/

research-toolkit-foundations/outputs/

research-toolkit-foundations/**

# Generated notebooks (regenerated on-demand)
*-with_outputs.ipynb

# Sibling worktree
main/

# SLURM allocation scripts — host-side only, not needed in the image
start-*
