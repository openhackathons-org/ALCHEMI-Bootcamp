#!/usr/bin/env bash
# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

sync_only=false
if (( $# > 1 )); then
    echo "Usage: $0 [--sync-only]" >&2
    exit 2
fi

case "${1:-}" in
    "")
        ;;
    --sync-only)
        sync_only=true
        ;;
    *)
        echo "Usage: $0 [--sync-only]" >&2
        exit 2
        ;;
esac

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime_root="${ALCHEMI_RUNTIME_ROOT:-/tmp/alchemi-runtime}"
uv_bin="${ALCHEMI_UV_BIN:-uv}"
install_profile="${ALCHEMI_INSTALL_PROFILE:-development}"
python_version="$(<"${repository_root}/.python-version")"

mkdir -p \
    "${runtime_root}/aimnet" \
    "${runtime_root}/cache" \
    "${runtime_root}/dftd3" \
    "${runtime_root}/huggingface" \
    "${runtime_root}/ipython" \
    "${runtime_root}/jupyter-config" \
    "${runtime_root}/jupyter-data" \
    "${runtime_root}/matplotlib" \
    "${runtime_root}/ruff" \
    "${runtime_root}/torch" \
    "${runtime_root}/torch-inductor" \
    "${runtime_root}/triton" \
    "${runtime_root}/uv-cache" \
    "${runtime_root}/warp"
export AIMNET_CACHE_DIR="${runtime_root}/aimnet"
export ALCHEMI_D3_PARAM_FILE="${runtime_root}/dftd3/dftd3_parameters.pt"
export HF_HOME="${runtime_root}/huggingface"
export IPYTHONDIR="${runtime_root}/ipython"
export JUPYTER_CONFIG_DIR="${runtime_root}/jupyter-config"
export JUPYTER_DATA_DIR="${runtime_root}/jupyter-data"
export MPLCONFIGDIR="${runtime_root}/matplotlib"
export RUFF_CACHE_DIR="${runtime_root}/ruff"
export TORCH_HOME="${runtime_root}/torch"
export TORCHINDUCTOR_CACHE_DIR="${runtime_root}/torch-inductor"
export TRITON_CACHE_DIR="${runtime_root}/triton"
export UV_CACHE_DIR="${runtime_root}/uv-cache"
export UV_PROJECT_ENVIRONMENT="${runtime_root}/venv"
export WARP_CACHE_PATH="${runtime_root}/warp"
export XDG_CACHE_HOME="${runtime_root}/cache"

sync_arguments=(
    sync
    --project "${repository_root}"
    --frozen
    --managed-python
    --python "${python_version}"
)
case "${install_profile}" in
    development)
        ;;
    brev)
        sync_arguments+=(--no-default-groups --group kernel)
        ;;
    runtime)
        sync_arguments+=(--no-default-groups)
        ;;
    *)
        echo "Unknown ALCHEMI install profile: ${install_profile}" >&2
        echo "Choose development, brev, or runtime." >&2
        exit 2
        ;;
esac

echo "Installing ALCHEMI profile: ${install_profile}"
"${uv_bin}" "${sync_arguments[@]}"
if [[ "${sync_only}" == true ]]; then
    exit 0
fi

"${uv_bin}" run --project "${repository_root}" --frozen --no-sync \
    --managed-python --python "${python_version}" \
    python "${repository_root}/environment/prewarm_assets.py"
