#!/usr/bin/env bash
set -euo pipefail

if (( $# > 0 )); then
    exec "$@"
fi

if [[ -z "${JUPYTER_TOKEN:-}" ]]; then
    echo "JUPYTER_TOKEN must be set when the container starts." >&2
    exit 2
fi

exec ./scripts/v3-run jupyter lab \
    --IdentityProvider.token="${JUPYTER_TOKEN}" \
    --ServerApp.root_dir=/workspace \
    --ip=0.0.0.0 \
    --no-browser \
    --port=8888
